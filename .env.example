# Copia este fichero a .env y rellena los valores.
# El fichero .env nunca se sube al repositorio.

# Cuenta de servicio de LaLiga Fantasy.
# Es la cuenta dedicada que pertenece a la liga y da acceso de lectura.
FANTASY_EMAIL=
FANTASY_PASSWORD=

# Liga sobre la que trabaja el bot.
FANTASY_LIGA_ID=

# Identificador de manager de la cuenta de servicio.
# Sirve para excluirla de las clasificaciones que narra el bot.
FANTASY_MANAGER_SERVICIO=

# Competición de Fantasy. El valor 1 es LaLiga.
FANTASY_COMPETICION_ID=1

# Carpeta donde se guardan la base de datos y la sesión.
DATOS_DIR=./data
